# Local Supabase: run `pnpm supabase start` and use the URL + anon key it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solana (devnet by default; never hardcode a cluster in code)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public key of the platform settlement authority. Sellers approve this key as
# a Core transfer delegate when listing, so sales can settle atomically later.
# Also the treasury a candy-machine drop's `solFixedFee` guard pays the platform fee to.
# Leave unset to deploy candy machines with no fee guard (local dev / self-hosted).
NEXT_PUBLIC_SETTLEMENT_AUTHORITY=

# Server-only (edge function secrets; set with `pnpm supabase secrets set` for hosted).
SUPABASE_SERVICE_ROLE_KEY=
# The settlement authority's secret key (base58). Local: supabase/functions/.env
SETTLEMENT_AUTHORITY_SECRET=
