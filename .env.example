# Copy to `.env.local` for local dev. Production deploy runbook: docs/DEPLOYMENT.md
#
# Groups below, split by *where the value is actually set*:
#   1.  Frontend, public — `.env.local` locally; Vercel project env vars in production.
#   1b. Frontend, server-only — same two places, but NOT in the browser bundle.
#   2.  Function secrets — `supabase/functions/.env` locally; `supabase secrets set` hosted.
#   3.  Local-only    — `supabase/functions/.env`; hosted Supabase injects these itself.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Frontend  (NEXT_PUBLIC_* — inlined into the browser bundle at BUILD time,
#    so changing one in Vercel needs a redeploy, not just a save. Nothing here
#    is secret; assume every value is readable by anyone using the site.)
# ─────────────────────────────────────────────────────────────────────────────

# Local Supabase: run `pnpm supabase start` and use the URL + anon key it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Keep this variable NAME even if the dashboard calls the value a "publishable
# key" — lib/supabase/{client,server}.ts and proxy.ts read ANON_KEY and nothing
# reads NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solana (devnet by default; never hardcode a cluster in code)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Public RPC works for light local use; a launchpad deploy will rate-limit on it.
# Production uses a Helius endpoint restricted by domain — see docs/DEPLOYMENT.md.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public key of the platform settlement authority. Sellers approve this key as
# a Core transfer delegate when listing, so sales can settle atomically later.
# This is the PUBLIC key of the keypair whose secret is SETTLEMENT_AUTHORITY_SECRET.
NEXT_PUBLIC_SETTLEMENT_AUTHORITY=

# ─────────────────────────────────────────────────────────────────────────────
# 1b. Frontend, server-only  (Vercel env vars, NO NEXT_PUBLIC_ prefix — read at
#     request time on the server, never inlined into the browser bundle. Unlike
#     group 1 these are read by the Next server runtime, so a change takes
#     effect without a rebuild.)
# ─────────────────────────────────────────────────────────────────────────────

# CoinGecko **Demo** (free tier) key, used only by lib/price/sol.ts to fetch the
# SOL/USD rate shown in the header and next to prices. Demo keys go to
# api.coingecko.com with the `x-cg-demo-api-key` header; a paid Pro key would
# need pro-api.coingecko.com and `x-cg-pro-api-key` instead, so don't just swap
# the value. OPTIONAL — leave blank and the same endpoint is called keyless on
# the shared public tier, which is rate-limited per IP.
#
# Display only: this number never touches lamport amounts, listings or
# settlement. When the fetch fails the app logs a `[sol-usd]` warning and falls
# back to a hardcoded rate, so check Vercel runtime logs if USD looks stale.
COINGECKO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 2. Edge function secrets
#    Local:  supabase/functions/.env
#    Hosted: pnpm supabase secrets set KEY=value --project-ref <ref>
#    Never NEXT_PUBLIC_*, never committed, never logged.
# ─────────────────────────────────────────────────────────────────────────────

# Server-side RPC. Read by `settle` and `candy-mint` to verify transactions
# against the chain. Use a SEPARATE key/endpoint from NEXT_PUBLIC_SOLANA_RPC_URL:
# this one is never exposed to a browser, so it needs no domain restriction.
SOLANA_RPC_URL=

# The settlement authority's secret key (base58). Read by `settle` only — it
# signs as the Core transfer delegate. The buyer pays every fee, so this wallet
# needs no balance. Treat it as a hot-wallet secret regardless.
SETTLEMENT_AUTHORITY_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 3. Local-only — supabase/functions/.env
#    `supabase functions serve` needs these explicitly. Hosted Edge Functions
#    get all three injected automatically: do NOT set them with `secrets set`.
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
